<%- include('partials/head', { title: 'Proyectos y cotizaciones' }) %>
<body>
<%- include('partials/sidebar', { activePage }) %>
<div class="lg:pl-64">
  <%- include('partials/topbar') %>
  <main class="px-4 pb-12 pt-36 sm:px-6 lg:px-10 lg:pt-24">
    <%- include('partials/page-header', {
      eyebrow: 'Flujos y entregables activos',
      heading: 'Gestión operativa y proyectos',
      description: 'Organiza tareas, oportunidades comerciales y próximos contactos desde un solo espacio.',
      actionHref: '#nueva-cotizacion',
      actionLabel: 'Crear cotización',
      actionIcon: 'add'
    }) %>

    <% if (success) { %>
      <div class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200">
        <%= success === 'creada' ? 'La cotización se guardó correctamente en los datos locales.' : 'El seguimiento se actualizó correctamente.' %>
      </div>
    <% } %>

    <section class="mb-7 grid gap-4 sm:grid-cols-3">
      <% [
        { label: 'Proyectos activos', value: database.tareas.filter((task) => task.estado !== 'Completada').length, icon: 'folder_open' },
        { label: 'En revisión', value: database.tareas.filter((task) => task.estado === 'En revisión').length, icon: 'rate_review' },
        { label: 'Cotizaciones', value: quotes.length, icon: 'request_quote' }
      ].forEach((metric) => { %>
        <article class="panel flex items-center justify-between p-5">
          <div><p class="text-xs text-soft"><%= metric.label %></p><p class="mt-2 text-2xl font-bold text-white"><%= metric.value %></p></div>
          <span class="material-symbols-outlined text-2xl text-cyan"><%= metric.icon %></span>
        </article>
      <% }); %>
    </section>

    <section class="mb-7 grid gap-5 xl:grid-cols-[1.2fr_.8fr]">
      <article class="panel p-5 sm:p-6">
        <div class="mb-5 flex items-center justify-between">
          <div><p class="text-sm font-semibold text-white">Tareas del equipo</p><p class="mt-1 text-xs text-soft">Seguimiento de entregables y responsables</p></div>
          <a href="/copiloto" class="text-xs font-semibold text-cyan">Consultar copiloto →</a>
        </div>
        <div class="space-y-3">
          <% database.tareas.forEach((task) => { %>
            <article class="rounded-xl border border-line bg-background/50 p-4" data-searchable>
              <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-raised text-cyan"><span class="material-symbols-outlined text-[18px]"><%= task.estado === 'Completada' ? 'task_alt' : 'assignment' %></span></span>
                  <div><p class="text-sm font-semibold text-white"><%= task.titulo %></p><p class="mt-1 text-xs text-soft"><%= task.proyecto %></p></div>
                </div>
                <span class="badge <%= task.prioridad === 'Alta' ? 'badge-amber' : 'badge-neutral' %>"><%= task.prioridad %></span>
              </div>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-[10px] text-soft">
                <span><%= task.responsable %> · vence <%= task.fechaLimite %></span>
                <span><%= task.estado %></span>
              </div>
              <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-raised"><div class="h-full rounded-full bg-cyan" style="width: <%= task.avance %>%"></div></div>
            </article>
          <% }); %>
        </div>
      </article>

      <article class="panel p-5 sm:p-6" id="nueva-cotizacion">
        <div class="mb-5">
          <p class="text-sm font-semibold text-white">Nueva cotización</p>
          <p class="mt-1 text-xs leading-5 text-soft">El total se calcula con IVA del 16%. Los importes se guardan en MXN.</p>
        </div>
        <form action="/cotizaciones" method="post" class="space-y-4">
          <label class="block text-xs font-medium text-soft">Cliente
            <select name="clienteId" required class="field mt-2">
              <option value="">Selecciona un cliente</option>
              <% database.clientes.forEach((client) => { %><option value="<%= client.id %>"><%= client.empresa %> · <%= client.nombre %></option><% }); %>
            </select>
          </label>
          <label class="block text-xs font-medium text-soft">Concepto
            <input name="concepto" maxlength="120" required class="field mt-2" placeholder="Ej. Integración de inventario">
          </label>
          <label class="block text-xs font-medium text-soft">Subtotal antes de IVA (MXN)
            <div class="relative mt-2"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-soft">$</span><input name="subtotal" type="number" min="1" max="100000000" step="0.01" required class="field pl-8" placeholder="85000"></div>
          </label>
          <button type="submit" class="w-full rounded-full bg-cyan px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-white">Guardar como borrador</button>
        </form>
        <div class="mt-6 rounded-xl border border-line bg-background/50 p-4">
          <p class="text-xs font-semibold text-white">Atajo operativo</p>
          <p class="mt-1 text-xs leading-5 text-soft">La propuesta se agrega a la tabla y queda lista para revisar antes de compartirla con el cliente.</p>
        </div>
      </article>
    </section>

    <section class="mb-7 grid gap-5 xl:grid-cols-[1.2fr_.8fr]">
      <article class="panel overflow-hidden">
        <div class="px-5 py-5 sm:px-6"><p class="text-sm font-semibold text-white">Pipeline de cotizaciones</p><p class="mt-1 text-xs text-soft">Importes incluyen IVA</p></div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] text-left text-xs">
            <thead class="bg-background/60 text-[10px] uppercase tracking-wider text-soft"><tr><th class="px-5 py-3 font-medium">Folio / cliente</th><th class="px-4 py-3 font-medium">Concepto</th><th class="px-4 py-3 font-medium">Total</th><th class="px-5 py-3 font-medium">Estado</th></tr></thead>
            <tbody>
              <% quotes.forEach((quote) => { %>
                <tr class="table-row" data-searchable>
                  <td class="px-5 py-4 font-semibold text-white"><%= quote.folio %><span class="mt-1 block font-normal text-soft"><%= quote.clienteNombre %></span></td>
                  <td class="max-w-64 px-4 py-4 text-soft"><%= quote.concepto %></td>
                  <td class="whitespace-nowrap px-4 py-4 font-semibold text-white"><%= formatMXN(quote.total) %></td>
                  <td class="px-5 py-4"><span class="badge <%= quote.estado === 'Aprobada' ? 'badge-success' : quote.estado === 'En negociación' ? 'badge-amber' : 'badge-neutral' %>"><%= quote.estado %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </article>

      <article class="panel p-5 sm:p-6" id="seguimientos">
        <div class="mb-4 flex items-center justify-between">
          <div><p class="text-sm font-semibold text-white">Seguimientos de WhatsApp</p><p class="mt-1 text-xs text-soft">Agenda de próximos pasos</p></div>
          <span class="material-symbols-outlined text-cyan">forum</span>
        </div>
        <div class="space-y-4">
          <% followups.forEach((item) => { %>
            <div class="border-b border-line pb-4 last:border-0 last:pb-0" data-searchable>
              <div class="flex items-center justify-between gap-3"><p class="text-sm font-semibold text-white"><%= item.contacto %></p><span class="badge <%= item.estado === 'Completado' ? 'badge-success' : 'badge-neutral' %>"><%= item.estado %></span></div>
              <p class="mt-1 text-[11px] text-soft"><%= item.clienteNombre %> · <%= item.fecha.slice(0, 10) %></p>
              <p class="mt-2 text-xs leading-5 text-slate-300"><%= item.proximoPaso %></p>
              <% if (item.estado !== 'Completado') { %>
                <form action="/seguimientos/<%= item.id %>/completar" method="post" class="mt-3">
                  <button type="submit" class="text-xs font-semibold text-cyan hover:text-white">Marcar como completado</button>
                </form>
              <% } %>
            </div>
          <% }); %>
        </div>
      </article>
    </section>
  </main>
</div>
<%- include('partials/shell-end') %>
