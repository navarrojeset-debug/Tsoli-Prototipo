      tailwind.config = {
        theme: {
          extend: {
            colors: {
              background: "#0b1017",
              surface: "#111822",
              panel: "#151f2b",
              raised: "#1d2a37",
              line: "#263746",
              cyan: "#4cd7f6",
              soft: "#9bb0c2",
              mint: "#7bd0ff",
              danger: "#ff8e91",
              amber: "#f6c66b"
            },
            fontFamily: { sans: ["Plus Jakarta Sans", "sans-serif"] }
