<aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col justify-between border-r border-line/70 bg-surface/90 px-4 py-6 backdrop-blur-xl lg:flex">
  <div>
    <a class="mb-9 flex items-center gap-3 px-2" href="/dashboard">
      <span class="grid h-10 w-10 place-items-center rounded-2xl bg-cyan text-slate-950 shadow-[0_0_24px_rgba(76,215,246,.25)]">
        <span class="material-symbols-outlined">hub</span>
      </span>
      <span>
        <span class="block text-sm font-bold tracking-wide text-white">TSOLI OS</span>
        <span class="mt-1 block text-[10px] font-semibold uppercase tracking-[.2em] text-cyan">Executive Core</span>
      </span>
    </a>
    <p class="mb-3 px-3 text-[10px] font-semibold uppercase tracking-[.2em] text-soft/60">Espacio de trabajo</p>
    <nav class="space-y-1">
      <% navigation.forEach((item) => { const active = activePage === item.id; %>
        <a href="<%= item.href %>" class="nav-link <%= active ? 'nav-link-active' : '' %>" <%= active ? 'aria-current="page"' : '' %>>
          <span class="material-symbols-outlined text-[19px]"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
      <% }); %>
    </nav>
  </div>
  <div class="rounded-2xl border border-line bg-panel p-4">
    <div class="mb-2 flex items-center gap-2 text-xs font-semibold text-slate-200">
      <span class="h-2 w-2 rounded-full bg-cyan shadow-[0_0_10px_#4cd7f6]"></span>
      Núcleo operativo
    </div>
    <p class="text-xs leading-5 text-soft">Datos de demostración guardados localmente en este prototipo.</p>
    <div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[10px] uppercase tracking-wider text-soft">
      <span>TSOLI OS</span><span>v4.2</span>
    </div>
  </div>
</aside>
