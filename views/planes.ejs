<%- include('partials/head', { title: 'Planes y suscripción' }) %>
<body>
<%- include('partials/sidebar', { activePage }) %>
<div class="lg:pl-64">
  <%- include('partials/topbar') %>
  <main class="px-4 pb-12 pt-36 sm:px-6 lg:px-10 lg:pt-24">
    <%- include('partials/page-header', {
      eyebrow: 'Gobernanza financiera',
      heading: 'Cuenta, facturación y suscripción',
      description: 'Compara los niveles disponibles y cambia el plan guardado para esta demostración.'
    }) %>

    <% if (saved) { %><div class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200">La suscripción de demostración se actualizó.</div><% } %>

    <section class="panel mb-6 flex flex-col justify-between gap-4 p-5 sm:flex-row sm:items-center sm:p-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-cyan">Suscripción actual</p>
        <p class="mt-2 text-lg font-bold text-white"><%= database.planes.find((plan) => plan.id === database.suscripcion.planId)?.nombre || 'Sin plan' %> · <%= database.suscripcion.periodo %></p>
        <p class="mt-1 text-xs text-soft"><%= database.suscripcion.usuarios %> usuarios · renovación <%= database.suscripcion.renovacion %></p>
      </div>
      <span class="badge badge-success">Activa</span>
    </section>

    <section class="grid items-stretch gap-5 lg:grid-cols-3">
      <% database.planes.forEach((plan) => { const current = plan.id === database.suscripcion.planId; %>
        <article class="panel relative flex flex-col p-5 sm:p-6 <%= current ? 'border-cyan/50 shadow-[0_0_30px_rgba(76,215,246,.08)]' : '' %>">
          <% if (current) { %><span class="absolute right-4 top-4 rounded-full bg-cyan/10 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-cyan">Plan actual</span><% } %>
          <div class="mb-4">
            <span class="text-[10px] font-semibold uppercase tracking-[.2em] text-soft"><%= plan.usuarios %> usuarios</span>
            <h2 class="mt-2 text-2xl font-bold text-white"><%= plan.nombre %></h2>
            <p class="mt-2 min-h-10 text-xs leading-5 text-soft"><%= plan.descripcion %></p>
          </div>
          <p class="mb-1 text-3xl font-bold text-white"><%= formatMXN(database.suscripcion.periodo === 'anual' ? plan.precioAnual : plan.precioMensual) %></p>
          <p class="mb-5 text-xs text-soft">MXN / usuario / mes · <%= database.suscripcion.periodo === 'anual' ? 'pago anual' : 'pago mensual' %></p>
          <ul class="mb-6 flex-1 space-y-3">
            <% plan.caracteristicas.forEach((feature) => { %>
              <li class="flex items-start gap-2 text-xs text-slate-200"><span class="material-symbols-outlined text-[17px] text-cyan">check_circle</span><%= feature %></li>
            <% }); %>
          </ul>
          <form action="/planes" method="post" class="space-y-3">
            <input type="hidden" name="planId" value="<%= plan.id %>">
            <label class="sr-only" for="periodo-<%= plan.id %>">Periodo de facturación de <%= plan.nombre %></label>
            <select id="periodo-<%= plan.id %>" name="periodo" class="field"><option value="anual" <%= database.suscripcion.periodo === 'anual' ? 'selected' : '' %>>Facturación anual</option><option value="mensual" <%= database.suscripcion.periodo === 'mensual' ? 'selected' : '' %>>Facturación mensual</option></select>
            <button type="submit" class="w-full rounded-full px-4 py-3 text-sm font-semibold transition <%= current ? 'border border-line bg-raised text-slate-100 hover:bg-cyan hover:text-slate-950' : 'bg-cyan text-slate-950 hover:bg-white' %>"><%= current ? 'Mantener este plan' : `Elegir ${plan.nombre}` %></button>
          </form>
        </article>
      <% }); %>
    </section>
    <p class="mt-5 text-center text-[10px] text-soft">Precios y selección de plan son ilustrativos; no se procesa ningún pago.</p>
  </main>
</div>
<%- include('partials/shell-end') %>
