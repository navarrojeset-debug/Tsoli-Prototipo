<%- include('partials/head', { title }) %>
<body class="grid min-h-screen place-items-center bg-background px-6 text-slate-100">
  <main class="panel w-full max-w-lg p-8 text-center">
    <p class="text-sm font-bold uppercase tracking-[.2em] text-cyan">TSOLI OS · <%= status %></p>
    <h1 class="mt-4 text-2xl font-bold text-white"><%= title %></h1>
    <p class="mt-3 text-sm leading-6 text-soft"><%= message %></p>
    <a class="mt-6 inline-flex rounded-full bg-cyan px-5 py-3 text-sm font-semibold text-slate-950" href="/dashboard">Volver al inicio</a>
  </main>
  <script src="/app.js" defer></script>
  <%- include('partials/chatbot-widget') %>
</body>
</html>
